{
  "name": "lyristage",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "LyriStage - 以歌词为主角的网易云音乐播放器（电脑 + 手机）",
  "author": "EdwardJT",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web:dev": "vite --config vite.web.config.mjs",
    "web:build": "vite build --config vite.web.config.mjs",
    "api:dev": "node server/dev.js",
    "test": "vitest run",
    "smoke": "node scripts/smoke/run.js",
    "test:integration": "vitest run --config vitest.integration.config.mjs"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "@unblockneteasemusic/server": "0.28.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@vitejs/plugin-vue": "6.0.9",
    "dexie": "4.4.6",
    "electron": "43.7.7",
    "electron-vite": "5.0.0",
    "pinia": "4.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "5.3.1"
  }
}
