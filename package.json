{
  "name": "lyristage",
  "version": "2.1.6",
  "private": true,
  "description": "LyriStage - 以歌词为主角的网易云音乐播放器（电脑 + 手机）",
  "author": "EdwardJT",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && patch-package",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web:dev": "vite --config vite.web.config.mjs",
    "web:build": "vite build --config vite.web.config.mjs",
    "api:dev": "node server/dev.js",
    "test": "vitest run",
    "smoke": "node scripts/smoke/run.js",
    "layout:check": "node scripts/layout-check/run.cjs",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "app:build": "vite build --config vite.web.config.mjs --mode app && cap sync android",
    "app:apk": "npm run app:build && cd android && gradlew.bat assembleDebug",
    "web:deploy": "vite build --config vite.web.config.mjs --mode web && cd deploy/lyristage && npx vercel@62.2.0 deploy --prod --yes",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "@unblockneteasemusic/server": "0.28.0",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/file-transfer": "2.0.6",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-media-session": "8.0.32",
    "@supabase/supabase-js": "2.117.2",
    "@vitejs/plugin-vue": "6.0.9",
    "dexie": "4.4.6",
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "patch-package": "8.0.1",
    "pinia": "4.0.3",
    "playwright-core": "1.59.1",
    "three": "0.170.0",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "5.3.1"
  }
}
