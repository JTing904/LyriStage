# LyriStage 环境变量范例：复制成 .env 再填写（.env 不会提交到 git）

# 用户数据（Supabase → Project Settings → API Keys）
# 留空则关闭"我喜欢 / 歌单 / 听歌记录 / 每日推荐 / 私人 FM"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 网页版的网易云 API 地址（默认 /api：开发时由 Vite 转发，部署后由 Vercel 转发）
# VITE_API_BASE=https://lyristage-api.vercel.app

# Supabase 数据库密码（新建项目时填的 Database Password）
SUPABASE_DB_PASSWORD=
